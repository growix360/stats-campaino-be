generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]

  output = "../../generated/client2"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL_DB2")
}

model Campaign {
  id             String    @id @default(uuid())
  campaignId     String    @unique
  name           String
  statMultiplier Float     @default(1.0)
  hasMultiplied  Boolean   @default(false)
  emailListId    String?
  emailBody      String
  subject        String
  createdBy      String
  templateName   String
  isRun          Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  userId         String?
}

model User {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique()
  password  String
  role      Role      @default(USER)
  phone     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model Links {
  id          String    @id @default(uuid())
  originalUrl String
  shortUrl    String
  clicks      Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
}

enum Role {
  MANAGER
  ADMIN
  USER
}
