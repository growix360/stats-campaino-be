{
  "name": "campaino-stater-service-be",
  "version": "1.0.0",
  "engines": {
    "node": ">=20.18.2"
  },
  "description": "Campaino stats injection and campaign audit microservice",
  "main": "src/index.ts",
  "repository": "https://github.com/campaino/campaino-stater-service-be",
  "scripts": {
    "start": "cross-env NODE_ENV=production yarn db:push:db2 && node build/src/index.js",
    "dev": "cross-env NODE_ENV=development nodemon src/index.ts",
    "test": "docker-compose -f docker-compose.only-db-test.yml up -d && yarn db:push:all && jest -i --colors --verbose --detectOpenHandles && docker-compose -f docker-compose.only-db-test.yml down",
    "test:watch": "docker-compose -f docker-compose.only-db-test.yml up -d && yarn db:push:all && jest -i --watchAll && docker-compose -f docker-compose.only-db-test.yml down",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier": "prettier --check **/*.ts",
    "prettier:fix": "prettier --write **/*.ts",
    "db:push": "prisma db push --accept-data-loss",
    "db:push:db2": "prisma db push --accept-data-loss --schema prisma/db2/schema.prisma",
    "db:push:all": "yarn db:push && yarn db:push:db2",
    "db:reset": "prisma db push --force-reset",
    "db:reset:db2": "prisma db push --force-reset --schema prisma/db2/schema.prisma",
    "db:reset:all": "yarn db:reset && yarn db:reset:db2",
    "db:studio": "prisma studio",
    "docker:prod": "docker-compose -f docker-compose.yml -f docker-compose.prod.yml up",
    "docker:dev": "docker-compose -f docker-compose.yml -f docker-compose.dev.yml up",
    "docker:test": "docker-compose -f docker-compose.yml -f docker-compose.test.yml up",
    "docker:dev-db:start": "docker-compose -f docker-compose.only-db-dev.yml up -d",
    "docker:dev-db:stop": "docker-compose -f docker-compose.only-db-dev.yml down",
    "build": "rimraf build && npx prisma generate --schema prisma/schema.prisma && npx prisma generate --schema prisma/db2/schema.prisma && tsc -p tsconfig.json",
    "prisma:generate:db2": "npx prisma generate --schema=prisma/db2/schema.prisma",
    "prisma:generate": "npx prisma generate --schema=prisma/schema.prisma",
    "prisma": "npx prisma generate --schema prisma/schema.prisma && npx prisma generate --schema prisma/db2/schema.prisma"
  },
  "keywords": [
    "campaino",
    "stats",
    "email-campaign",
    "node",
    "typescript",
    "express",
    "prisma",
    "postgresql"
  ],
  "author": "Campaino",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.20.5",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/xss-filters": "^1.2.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "http-status": "^2.1.0",
    "joi": "^17.13.9",
    "moment": "^2.31.0",
    "morgan": "^1.12.1",
    "openapi-types": "^12.1.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pm2": "^7.1.2",
    "prisma": "^6.19.3",
    "rimraf": "^6.1.4",
    "typescript": "^5.7.3",
    "winston": "^3.19.0",
    "xss-filters": "^1.2.7",
    "multer": "^1.4.5-lts.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@jest/globals": "^29.7.0",
    "@types/multer": "^1.4.12",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.23.0",
    "@typescript-eslint/parser": "^8.23.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.19.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.3",
    "jest": "^29.7.0",
    "jiti": "^2.7.0",
    "node-mocks-http": "^1.16.2",
    "nodemon": "^3.1.14",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript-eslint": "^8.23.0"
  },
  "resolutions": {
    "qs": "^6.17.1",
    "body-parser": "^1.20.3",
    "send": "^0.19.0",
    "serve-static": "^1.16.2",
    "path-to-regexp": "^0.1.12",
    "cookie": "^0.7.2",
    "ip": "^2.0.1",
    "deepmerge": "^4.3.1",
    "micromatch": "^4.0.8",
    "braces": "^3.0.3",
    "brace-expansion": "^1.1.16",
    "@humanfs/node": "^0.16.8",
    "follow-redirects": "^1.15.9",
    "proxy-addr": "^2.0.7",
    "js-yaml": "^4.1.0",
    "minimatch": "^9.0.5",
    "deepmerge-ts": "^7.1.5",
    "deepmerge": "^4.3.1",
    "browserslist": "^4.24.4",
    "baseline-browser-mapping": "^2.11.0"
  },
  "overrides": {
    "js-yaml": "^4.2.0",
    "ws": "^8.20.1"
  }
}
