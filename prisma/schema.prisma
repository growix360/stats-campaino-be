generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
  output        = "../generated/client1"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Campaign {
  id              String    @id @default(uuid())
  campaignCode    String?   @unique
  name            String
  subject         String
  link            String
  ctaText         String    @default("Click Here")
  emailBody       String
  emailListId     String?
  domainId        String?
  createdBy       String
  templateName    String
  templateId      String
  hasCompleted    Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  emails      Email[]
  openEvents  Open[]
  clickEvents Click[]

  createdByUser User       @relation("UserCampaigns", fields: [createdBy], references: [id])
  emailList     EmailList? @relation(fields: [emailListId], references: [id])
  template      Template?  @relation(fields: [templateId], references: [id])
  domain        Domain?    @relation(fields: [domainId], references: [id])

  @@index([domainId])
}

model Domain {
  id        String    @id @default(uuid())
  fromEmail String
  fromName  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  campaigns   Campaign[]
  userDomains UserDomain[]

  @@index([fromEmail])
}

model UserDomain {
  userId    String
  domainId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  domain Domain @relation(fields: [domainId], references: [id])

  @@id([userId, domainId])
  @@index([userId])
  @@index([domainId])
}

model EmailList {
  id              String     @id @default(uuid())
  name            String
  totalRecords    Int?
  insertedRecords Int?
  updatedRecords  Int?
  invalidRecords  Int?
  emails          String[]
  uploadedAt      DateTime   @default(now())
  isUsed          Boolean    @default(false)
  allowReuse      Boolean    @default(false)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?
  campaigns       Campaign[]
}

model User {
  id               String       @id @default(uuid())
  name             String
  email            String       @unique()
  password         String
  role             Role         @default(USER)
  phone            String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  deletedAt        DateTime?
  campaigns        Campaign[]   @relation("UserCampaigns")
  createdTemplates Template[]   @relation("UserTemplates")
  userDomains      UserDomain[]
}

model Email {
  id              String      @id @default(uuid())
  recipientCode   String?     @unique
  email           String
  campaignId      String
  deliveryStatus  EmailStatus
  message         String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?

  campaign Campaign @relation(fields: [campaignId], references: [id])

  openEvents  Open[]
  clickEvents Click[]

  @@index([campaignId])
}

model Open {
  id         String   @id @default(uuid())
  emailId    String
  campaignId String
  ipAddress  String
  userAgent  String
  createdAt  DateTime @default(now())

  email    Email    @relation(fields: [emailId], references: [id])
  campaign Campaign @relation(fields: [campaignId], references: [id])

  @@index([campaignId])
  @@index([emailId])
}

model Click {
  id         String   @id @default(uuid())
  clickCode  String?  @unique
  emailId    String
  campaignId String
  ipAddress  String
  userAgent  String
  createdAt  DateTime @default(now())

  email    Email    @relation(fields: [emailId], references: [id])
  campaign Campaign @relation(fields: [campaignId], references: [id])

  @@index([campaignId])
  @@index([emailId])
}

model Links {
  id          String    @id @default(uuid())
  title       String    @default("")
  originalUrl String
  shortUrl    String
  clicks      Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
}

model Template {
  id                 String     @id @default(uuid())
  name               String     @unique
  subject            String
  providerTemplateId String?
  emailBody          String
  createdBy          String
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  deletedAt          DateTime?
  createdByUser      User       @relation("UserTemplates", fields: [createdBy], references: [id])
  Campaign           Campaign[]
}

enum Role {
  MANAGER
  ADMIN
  USER
}

enum EmailStatus {
  SENT
  DELIVERED
  OPENED
  CLICKED
  UNSUBSCRIBED
  UNSENT
  SPAM
  UNSOLICITED
  UNSUCCESSFUL
}
