generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
  output        = "../generated/client1"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Campaign {
  id           String    @id @default(uuid())
  name         String
  subject      String
  link         String
  emailBody    String
  emailListId  String?
  createdBy    String
  templateName String
  templateId   String // Reference to the template used
  hasCompleted Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  emails      Email[]
  openEvents  Open[]
  clickEvents Click[]

  createdByUser User       @relation("UserCampaigns", fields: [createdBy], references: [id])
  emailList     EmailList? @relation(fields: [emailListId], references: [id])
  template      Template?  @relation(fields: [templateId], references: [id]) // Relation to Template model
}

model EmailList {
  id         String     @id @default(uuid())
  name       String
  emails     String[]
  uploadedAt DateTime   @default(now())
  isUsed     Boolean    @default(false)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  deletedAt  DateTime?
  campaigns  Campaign[]
}

model User {
  id               String     @id @default(uuid())
  name             String
  email            String     @unique()
  password         String
  role             Role       @default(USER)
  phone            String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  deletedAt        DateTime?
  campaigns        Campaign[] @relation("UserCampaigns")
  createdTemplates Template[] @relation("UserTemplates")
}

model Email {
  id             String      @id @default(uuid())
  email          String
  messageId      String?     @unique
  campaignId     String
  deliveryStatus EmailStatus
  message        String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  deletedAt      DateTime?

  campaign Campaign @relation(fields: [campaignId], references: [id])

  openEvents  Open[]
  clickEvents Click[]
}

model Open {
  id         String   @id @default(uuid())
  emailId    String
  campaignId String
  ipAddress  String
  userAgent  String
  createdAt  DateTime @default(now())

  email    Email    @relation(fields: [emailId], references: [id])
  campaign Campaign @relation(fields: [campaignId], references: [id])
}

model Click {
  id         String   @id @default(uuid())
  emailId    String
  campaignId String
  ipAddress  String
  userAgent  String
  createdAt  DateTime @default(now())

  email    Email    @relation(fields: [emailId], references: [id])
  campaign Campaign @relation(fields: [campaignId], references: [id])
}

model Links {
  id          String    @id @default(uuid())
  originalUrl String
  shortUrl    String
  clicks      Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
}

model Template {
  id            String     @id @default(uuid())
  name          String     @unique
  subject       String
  emailBody     String
  createdBy     String
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  deletedAt     DateTime?
  createdByUser User       @relation("UserTemplates", fields: [createdBy], references: [id])
  userId        String?
  Campaign      Campaign[]
}

enum Role {
  MANAGER
  ADMIN
  USER
}

enum EmailStatus {
  Send
  RenderingFailure
  Reject
  Delivery
  Bounce
  Complaint
  DeliveryDelay
  Subscription
  MessageRejected
}
