# Port number
PORT=3001

# Must match main backend (campaino-mailchimp) JWT_SECRET for shared User login
JWT_SECRET=thisisasamplesecret

# DB1: same database as main email backend (campaigns, emails, opens, clicks)
DATABASE_URL=postgresql://postgres:secret@localhost:5432/emailcompaign?schema=public

# DB2: stater audit log (stats update history)
DATABASE_URL_DB2=postgresql://postgres:secret@localhost:5432/statstracker?schema=public

# Default email pool for sent increases (optional override)
CUSTOMERS_CSV_PATH=docs/customers-100000.csv

# Stats update safety limits
MAX_STATS_INCREASE_PER_REQUEST=10000
MAX_UPLOAD_EMAILS=50000
